{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "filesystem": {
      "type": "local",
      "enabled": true,
      "command": ["npx", "-y", "@modelcontextprotocol/server-filesystem", "."]
    },
    "websearch": {
      "type": "local",
      "enabled": true,
      "command": ["npx", "git+https://github.com/pskill9/web-search"]
    },
    "tailwind": {
      "type": "local",
      "enabled": true,
      "command": ["npx", "-y", "tailwindcss-mcp-server"]
    }
  },
  "permission": {
    "filesystem_*": "ask",
    "websearch_*": "allow",
    "bash": "ask",
    "edit": "ask"
  }
}
